# LLM 配置（DeepSeek Responses API）
# 在 https://platform.deepseek.com/ 创建并填入你的 API Key（请勿提交真实 Key 到仓库）
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Responses API 目前仅支持 deepseek-v4-flash；
# deepseek-v4-pro 预计 2026 年 8 月初支持，届时可切换
DEEPSEEK_MODEL=deepseek-v4-flash

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 数据库（自托管 PostgreSQL）
# 本地开发连接 localhost；Docker Compose 内部会自动覆盖为 db 服务地址
DATABASE_URL=postgres://autodoc:你的数据库密码@localhost:5432/autodoc
POSTGRES_USER=autodoc
POSTGRES_PASSWORD=你的数据库密码
POSTGRES_DB=autodoc

# 会话签名密钥（JWT，务必使用足够长的随机字符串，生产环境必须更换）
JWT_SECRET=请设置一个足够长的随机字符串
