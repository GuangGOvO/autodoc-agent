# LLM 配置（DeepSeek Responses API）
# 在 https://platform.deepseek.com/ 创建并填入你的 API Key（请勿提交真实 Key 到仓库）
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Responses API 目前仅支持 deepseek-v4-flash；
# deepseek-v4-pro 预计 2026 年 8 月初支持，届时可切换
DEEPSEEK_MODEL=deepseek-v4-flash

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase（登录/认证与数据存储）
# 在 https://supabase.com 创建项目后，将 URL 与 anon key 填入
NEXT_PUBLIC_SUPABASE_URL=https://你的项目.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的anon-key
# 服务端专用（可选，用于 Server Client；默认回退到 anon key）
SUPABASE_SERVICE_ROLE_KEY=你的service-role-key
